{
  "name": "customizable-search-demo",
  "version": "2.0.0",
  "description": "Cloneable Elastic search demo for SA customer presentations",
  "scripts": {
    "dev": "pnpm exec serve output -l tcp://127.0.0.1:3000 -c ../serve.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "validate": "node scripts/validate-env.js",
    "setup": "node scripts/setup-index.js",
    "reset": "node scripts/setup-index.js --reset",
    "generate-test": "node scripts/generate-test.js",
    "inject": "node scripts/inject-credentials.js",
    "sbom": "cyclonedx-npm --output-file sbom.cdx.json",
    "hooks": "git config core.hooksPath .githooks",
    "test:guard": "sh .githooks/test-guard.sh"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@elastic/elasticsearch": "^9.4.2",
    "csv-parse": "^7.0.2",
    "serve": "^14.2.6"
  },
  "dependencies": {
    "libxmljs2": "0.37.0"
  }
}
