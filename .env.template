# Demo credentials. Copy to .env (gitignored) and fill in.
# Per-demo values (index, tool and agent ids) are NOT in .env; they live in
# output/<slug>/demo.config.json, written by `pnpm run setup -- --slug <slug>`.

# Elasticsearch (Cloud Hosted)
# Your deployment URL — e.g. https://my-deployment.es.us-east-1.aws.cloud.es.io
ES_URL=https://your-deployment.es.region.cloud.es.io

# Write key (NOT stored here)
# Used ONCE by `pnpm run setup` to create the index, seed data, and create the Agent Builder agent.
# Never baked into the demo HTML and never read from .env. Keep it in the macOS Keychain:
#   security add-generic-password -s customizable-search-demo -a ES_API_KEY -w
#     (prompts for the value; add -U to update an existing entry)
#   security find-generic-password -s customizable-search-demo -a ES_API_KEY -w   (read-back)
# On non-macOS or CI, export the ES_API_KEY environment variable instead.
# An ES_API_KEY entry in this file is ignored with a warning.
# Create in Kibana: Stack Management → API Keys → Create API key
# Paste this exact JSON into the "Restrict privileges" field:
# {
#   "demo-setup": {
#     "cluster": ["monitor_inference"],
#     "indices": [
#       { "names": ["*"], "privileges": ["all"] }
#     ],
#     "applications": [
#       { "application": "kibana-.kibana", "privileges": ["manage_onechat"], "resources": ["*"] }
#     ]
#   }
# }

# Base prefix for demo index names. Each demo's index is ${ES_INDEX}-<slug>.
ES_INDEX=demo-products

# Read-only API key — written into output/<slug>/config.js by `pnpm run inject` for ES queries.
# Create in Kibana: Stack Management → API Keys → Create API key
# Paste this exact JSON into the "Restrict privileges" field:
# {
#   "demo-readonly": {
#     "cluster": ["monitor_inference"],
#     "indices": [
#       { "names": ["demo-*"], "privileges": ["read", "view_index_metadata"] }
#     ]
#   }
# }
# The "names" pattern must cover every demo index. Default naming is ${ES_INDEX}-<slug>, but some
# demos keep custom names (list yours with the "indexName" field in output/<slug>/demo.config.json).
# Add a pattern per custom name; never use "*".
# This key reaches the browser, so create it with an expiration (top level of the create request,
# e.g. "expiration": "30d"). One key per demo or per engagement is preferred.
ES_API_KEY_READONLY=your_readonly_api_key_here

# Kibana URL — e.g. https://my-deployment.kb.us-east-1.aws.cloud.es.io
KIBANA_URL=https://your-deployment.kb.region.cloud.es.io

# Kibana API key — written into output/<slug>/config.js for Agent Builder conversations.
# A separate key from ES_API_KEY_READONLY (the read-only ES key has no Kibana privileges and gets 403).
# Create in Kibana: Stack Management → API Keys → Create API key (use an expiration here too).
# Paste this exact JSON into the "Restrict privileges" field:
# {
#   "demo-kibana": {
#     "cluster": ["monitor_inference"],
#     "indices": [
#       { "names": ["demo-*"], "privileges": ["read", "view_index_metadata"] }
#     ],
#     "applications": [
#       { "application": "kibana-.kibana", "privileges": ["feature_agentBuilder.read", "feature_actions.read"], "resources": ["space:default"] }
#     ]
#   }
# }
# Same index-pattern rule as above. feature_actions.read is retained pending a test of whether it is needed.
KIBANA_API_KEY=your_kibana_api_key_here

# Jina Omni inference endpoint — required for DAM Media mode (image/audio similarity search)
# This is a cluster-specific external endpoint ID (not an EIS dot-prefixed ID).
# Find it in Kibana: Search → Inference Endpoints
JINA_OMNI_INFERENCE_ID=your_omni_inference_id_here
