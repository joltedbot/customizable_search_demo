# Elasticsearch (Cloud Hosted)
# Your deployment URL — e.g. https://my-deployment.es.us-east-1.aws.cloud.es.io
ES_URL=https://your-deployment.es.region.cloud.es.io

# Write API key — used ONCE by `npm run setup` to create the index, seed data, and create the Agent Builder agent.
# Never baked into the demo HTML.
# Create in Kibana: Stack Management → API Keys → Create API key
# Paste this exact JSON into the "Restrict privileges" field:
# {
#   "demo-setup": {
#     "cluster": ["monitor_inference"],
#     "indices": [
#       { "names": ["*"], "privileges": ["all"] }
#     ],
#     "applications": [
#       { "application": "kibana-.kibana", "privileges": ["manage_onechat"], "resources": ["*"] }
#     ]
#   }
# }
ES_API_KEY=your_write_api_key_here

# Index name — leave as-is unless you need multiple demo indexes
ES_INDEX=demo-products

# Read-only API key — baked into the generated demo.html for both ES queries and Agent Builder conversations.
# Create in Kibana: Stack Management → API Keys → Create API key
# Paste this exact JSON into the "Restrict privileges" field:
# {
#   "demo-readonly": {
#     "cluster": ["monitor_inference"],
#     "indices": [
#       { "names": ["*"], "privileges": ["read", "view_index_metadata"] }
#     ],
#     "applications": [
#       { "application": "kibana-.kibana", "privileges": ["feature_agentBuilder.read", "feature_actions.read"], "resources": ["*"] }
#     ]
#   }
# }
ES_API_KEY_READONLY=your_readonly_api_key_here

# Kibana URL — e.g. https://my-deployment.kb.us-east-1.aws.cloud.es.io
KIBANA_URL=https://your-deployment.kb.region.cloud.es.io

# Agent ID — auto-populated by npm run setup. Override to use a manually-created agent.
AGENT_ID=
