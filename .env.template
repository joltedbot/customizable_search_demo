# Elasticsearch (Cloud Hosted)
# Your deployment URL — e.g. https://my-deployment.es.us-east-1.aws.cloud.es.io
ES_URL=https://your-deployment.es.region.cloud.es.io

# Write API key — used ONCE by `npm run setup` to create the index and seed data.
# Create this in Kibana: Stack Management → API Keys → Create API key (no restrictions needed)
ES_API_KEY=your_write_api_key_here

# Index name — leave as-is unless you need multiple demo indexes
ES_INDEX=demo-products

# Read-only API key — baked into the generated demo.html for browser queries.
# Create in Kibana with index privileges: read, view_index_metadata on ES_INDEX only.
ES_API_KEY_READONLY=your_readonly_api_key_here

# Elastic Inference endpoint (GenAI chat mode) — optional
# URL: your ES cluster URL + /_inference/completion/{inference_id}
# e.g. https://your-deployment.es.region.cloud.es.io/_inference/completion/my-inference-id
ES_INFERENCE_URL=https://your-deployment.es.region.cloud.es.io/_inference/completion/your-inference-id
ES_INFERENCE_API_KEY=your_inference_api_key_here
